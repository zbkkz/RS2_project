# 环境：development / production
FLASK_ENV=development

# Flask 密钥（生产环境务必更换为随机字符串）
SECRET_KEY=dev-secret-key
# JWT 密钥（生产环境务必更换为随机字符串）
JWT_SECRET_KEY=dev-jwt-secret

# MySQL 连接串
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/rs2_db?charset=utf8mb4

# 微信小程序配置（微信一键登录使用，填入真实 AppID/Secret）
WECHAT_APPID=
WECHAT_SECRET=

# AI 能力配置（默认阿里云百炼 DashScope；启用在 .env 填入真实 Key）
AI_API_KEY=
# 基础地址（**留空 = 使用默认值** https://dashscope.aliyuncs.com/api/v1；
# config.py 会把空串当作未配置，见 README 10 章「空串不等于未配置」）
AI_API_BASE=https://dashscope.aliyuncs.com/api/v1
# 图像编辑模型（图生图；默认 qwen-image-2.0-pro，实测约 14s/张、输出按输入比例归一化到 ~1.05MP）
# 注：原 qwen-image-edit-plus 已于 2026-10 被百炼下线（Model not exist），换成同输出规格的 2.0-pro，见 README M51。
# 想要更高输出分辨率（约 4.2MP）可换 qwen-image-2.1-pro（约 28s）或 qwen-image-3.0-pro（约 85s），见 README 7.3
AI_MODEL=qwen-image-2.0-pro
# 素材生成脚本用的**文生图**模型（generate_floats.py / generate_title.py；与上面的编辑模型相互独立，
# 缺省 qwen-image-3.0-pro —— 编辑模型不接受纯文本输入）
AI_T2I_MODEL=qwen-image-3.0-pro
# 每用户每日 AI 调用上限（全局缺省值，与 config.py 的默认值一致；联动错误码 3003，见 README 7.3 / 10）
AI_DAILY_LIMIT=20
# 送 AI 前图片长边上限（像素；0 表示不缩放。控制 base64 体积与内存；实测与出图耗时基本无关）
AI_MAX_EDGE=2048
# 单次 AI 能力的生成阶段总预算（秒，含重试与轮询；默认 240）。
# 必须与小程序端等待成对调整：本项 + 结果图下载 30s 要小于
# app.json 的 networkTimeout.uploadFile(300s) 与前端 AI_UPLOAD_TIMEOUT(360s)，见 README 7.2
AI_TOTAL_TIMEOUT=240

# —— AI 临时图自动回收（见 README 7.5）——
# 后端启动后由后台守护线程定期回收 uploads/ai/ 下不再被引用的临时图（判定同 cleanup_temp.py）。
# 设 0 可关闭自动线程，改用系统计划任务 / 容器 sidecar 跑 cleanup_temp.py
AUTO_CLEANUP=1
# 两次回收的最小间隔（小时）与首次执行前的延迟（秒，避开启动期）
AUTO_CLEANUP_INTERVAL_HOURS=6
AUTO_CLEANUP_FIRST_DELAY_SEC=60
# 保留期（按文件修改时间算）：无引用的临时图 24h；仅被对话消息引用的图 168h（7 天）
AI_TEMP_KEEP_HOURS=24
AI_TEMP_CHAT_KEEP_HOURS=168

# —— 对话链路（「AI 智能处理」聊天页，见 README 7.4）——
# 文本对话与语音识别走百炼 **OpenAI 兼容端点**（与上面图像能力的原生 AI_API_BASE 分开）：
#   默认 https://dashscope.aliyuncs.com/compatible-mode/v1（留空 = 使用默认值）
AI_CHAT_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 文本对话模型（默认 qwen-plus）。注意：**不能填 qwen-image-* 图像编辑模型** ——
# 它只接受「图 + 文 → 图」，无法做纯文本对话（见 README M39）
AI_CHAT_MODEL=qwen-plus
# 语音识别模型（默认 qwen3-asr-flash）。音频**必须**以 data URI 内联传入，
# 裸 base64 会被上游判为非法 URL 而 400（2026-10 实测，见 README 7.4）
AI_ASR_MODEL=qwen3-asr-flash
# 单次对话/识别的读取超时（秒；对话是秒级短请求，与图像能力的 240s 预算无关）
AI_CHAT_TIMEOUT=60
# 送模型的**历史消息条数**上限（user+ai 各算一条；20 条 ≈ 10 轮对话）。
# 太小会让模型「失忆」（「再来一次」「把海星也去掉」接不上上下文），太大则 token 与耗时线性增长
AI_CHAT_MAX_TURNS=20
# 每用户每日「对话轮数」上限 / 「对话内出图」次数上限（留空即回落上面的全局 AI_DAILY_LIMIT）
AI_DAILY_LIMIT_CHAT=
AI_DAILY_LIMIT_CHAT_EDIT=

# —— 按能力可选覆盖（**留空即回落上面的全局值**，六个能力名：
#    matting / style / enhance / beauty / background / hair）——
# 用途：给某个能力单独换密钥、换模型、或单独收紧每日上限；不动这几行则六个能力全走全局配置。
# 注意：拆密钥不构成能力隔离（同账号任意密钥都能调该账号任意模型），
#      「某能力只能干本能力的事」由服务端固定指令 + 风格白名单保证（见 README 7.3）。
# AI_API_KEY_MATTING=
# AI_MODEL_BEAUTY=
# AI_DAILY_LIMIT_STYLE=
