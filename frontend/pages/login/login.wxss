/* pages/login/login.wxss */
page {
  height: 100vh;
  background: #ffffff;
}

.stage {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

/* ========== 漂浮物品 ========== */
/* 第 1 层：屏幕定位（拖动中的层级提升由 WXS 内联设置） */
.float-pos {
  position: absolute;
  z-index: 1;
}

/* 第 2 层：飞入过渡（打开小程序时从四周飞入） */
.float-fly {
  opacity: 0;
  transform: translate(var(--fx), var(--fy)) rotate(var(--fr));
  transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.6s ease;
}

.float-fly.entered {
  opacity: 1;
  transform: translate(0, 0) rotate(0deg);
}

/* 第 3 层：持续自由轻微晃动 */
.float-sway {
  animation: sway 3.4s ease-in-out infinite;
}

@keyframes sway {
  0%, 100% { transform: translate(0, 0) rotate(0deg); }
  25% { transform: translate(4rpx, -7rpx) rotate(2deg); }
  50% { transform: translate(-4rpx, 5rpx) rotate(-1.6deg); }
  75% { transform: translate(3rpx, 4rpx) rotate(1.2deg); }
}

/* 第 4 层：拖动跟手 / 松手回弹（transform 与回弹过渡由 WXS 内联控制） */
.float-item {
  will-change: transform;
}

.float-img {
  display: block;
}

/* 物品下方投影（不随拖动/晃动） */
.float-shadow {
  height: 16rpx;
  margin: 6rpx auto 0;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(60, 60, 80, 0.16), rgba(60, 60, 80, 0) 70%);
}

/* ========== 粉紫方块 ========== */
.cube {
  position: absolute;
  left: 50%;
  top: calc(100vh - 1260rpx);
  transform: translateX(-50%);
  width: 170rpx;
  height: 170rpx;
  border-radius: 36rpx;
  background: linear-gradient(150deg, #f2b6e0 0%, #d69ae4 55%, #bd8ce0 100%);
  box-shadow: 0 18rpx 44rpx rgba(200, 130, 220, 0.35),
    inset 0 -8rpx 16rpx rgba(150, 80, 180, 0.22),
    inset 0 6rpx 12rpx rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  /* 登录成功转场：放大铺满全屏（目标 transform 由行内 style 给出） */
  transition: transform 0.72s cubic-bezier(0.65, 0, 0.35, 1);
}

/* ========== 登录成功转场（登录页 → 首页共享元素过渡） ========== */
/* 时序（与 login.js 的 FLY_MS / BOOM_MS 联动）：
   ① 镜头克隆体飞行 0.5s 至首页摄像头位；② 方块背景向四周扩展 0.72s 铺满全屏，
   登录页元素保持原位、被扩展的背景覆盖而消失（不做渐隐）；
   ③ 铺屏末尾 boom-veil 叠化出首页同款深紫渐变，随后 reLaunch 首页 */

/* 方块内镜头立即隐去（由 fly-eye 克隆体接力飞行，位置一致无缝衔接） */
.stage.leaving .cube .eye {
  opacity: 0;
}

/* 背景扩展阶段：方块层级提到卡片(10/11)/弹层(30) 之上、fly-eye(60) 之下，确保覆盖而非被遮挡 */
.cube.cube-boom {
  z-index: 40;
}

/* 铺屏末尾叠化首页渐变（1.02s 起 0.24s 淡入，结束即 reLaunch，换页无色差） */
.boom-veil {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  background: linear-gradient(108deg, #eac4eb 0%, #bd8ed4 26%, #8463ac 52%, #4a3d7c 78%, #29234f 100%);
  opacity: 0;
  animation: veil-in 0.24s ease 1.02s forwards;
}

@keyframes veil-in {
  to { opacity: 1; }
}

/* 飞行镜头：fixed 定位，起点(left/top)与基础居中 transform 由行内 style 给出，
   飞行+变形也由行内 style 的 transform + transition 完成（login.js 隔一帧写入终点 flyTo）。
   **不用 this.animate**：ComponentInstance#animate 在部分环境未实现（WebView 渲染器 / 开发者工具），
   会抛 "unimplemented: ComponentInstance#animate" 且镜头完全不飞。 */
.fly-eye {
  position: fixed;
  z-index: 60;
  width: 108rpx;
  height: 108rpx;
  background: radial-gradient(circle at 36% 30%, #ffffff 0%, #f3e7f8 100%);
  border: 6rpx solid #1c1c1e;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(120, 60, 160, 0.35);
  /* 兜底居中：行内 style 的 transform 会覆盖它 */
  transform: translate(-50%, -50%);
}

.fly-pupil {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 38% 32%, #3c3c44 0%, #17171b 72%);
  border: 4rpx solid #d69ae4;
}

/* 镜头眼睛：白面（带粉紫光泽）+ 黑色外圈 + 粉紫饰环黑盘，贴合页面粉紫镜头风格；
   keyframes 自由眨眼 */
.eye {
  width: 108rpx;
  height: 108rpx;
  background: radial-gradient(circle at 36% 30%, #ffffff 0%, #f3e7f8 100%);
  border: 6rpx solid #1c1c1e;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  animation: blink 4.6s ease-in-out infinite;
}

@keyframes blink {
  0%, 90%, 100% { transform: scaleY(1); }
  93%, 96% { transform: scaleY(0.08); }
}

/* 镜头内圆盘：深色镜片 + 粉紫饰环（呼应方块渐变色），注视位移由 WXS 内联控制 */
.pupil {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 38% 32%, #3c3c44 0%, #17171b 72%);
  border: 4rpx solid #d69ae4;
  transition: transform 0.12s ease-out;
}

/* 镜头中心白孔（居中，随圆盘一同位移） */
.pupil-shine {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ffffff;
  transform: translate(-50%, -50%);
}

/* 镜片玻璃反光点（随圆盘一同位移） */
.pupil-glint {
  position: absolute;
  left: 22%;
  top: 18%;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
}

/* ========== Hi.cut 标题：物品飞入后缓慢淡入 ========== */
.title-wrap {
  position: absolute;
  left: 50%;
  top: calc(100vh - 1076rpx);
  width: 340rpx;
  z-index: 2;
  opacity: 0;
  transform: translateX(-50%) translateY(24rpx) scale(0.94);
  transition: opacity 1.2s ease, transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
}

.title-wrap.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0) scale(1);
}

.title-img {
  width: 340rpx;
  display: block;
}

/* ========== 卡片包装层：位移切换（登录/注册卡片共用） ========== */
/* 隐藏时整体移出屏幕底部（毛玻璃随卡片一并在屏外，不会作用于页面内容）；
   默认过渡为弹簧曲线（卡片间切换用），slow 为首屏缓慢入场 */
.panel-wrap {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 34rpx;
  z-index: 10;
  opacity: 0;
  transform: translateY(calc(100% + 60rpx));
  transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.4s ease;
}

/* 首屏入场：缓慢平稳（无回弹） */
.panel-wrap.slow {
  transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1), opacity 1.1s ease;
}

/* 向上弹入到位 */
.panel-wrap.in {
  opacity: 1;
  transform: translateY(0);
}

/* 向下弹出：加速下落，带重力感 */
.panel-wrap.out {
  opacity: 0;
  transform: translateY(calc(100% + 60rpx));
  transition: transform 0.38s cubic-bezier(0.55, 0, 0.55, 0.2), opacity 0.32s ease;
}

/* 注册卡片叠在登录卡片之上（切换重叠期入场卡盖住出场卡） */
.register-wrap {
  z-index: 11;
}

/* ========== 果冻脉动层：卡片弹入到位后挤压-拉伸一次 ========== */
.panel-jelly.jelly {
  animation: jelly-squash 0.55s ease-out 0.5s both;
}

@keyframes jelly-squash {
  0% { transform: scale(1, 1); }
  28% { transform: scale(1.045, 0.94); }
  52% { transform: scale(0.965, 1.035); }
  74% { transform: scale(1.018, 0.985); }
  100% { transform: scale(1, 1); }
}

/* ========== 卡片本体：毛玻璃 + 蓝粉渐变（登录/注册卡片视觉完全一致） ========== */
.login-panel {
  padding: 32rpx 40rpx 20rpx;
  border-radius: 40rpx;
  background: linear-gradient(155deg,
    rgba(125, 186, 255, 0.5) 0%,
    rgba(196, 200, 255, 0.42) 45%,
    rgba(255, 168, 214, 0.5) 100%);
  -webkit-backdrop-filter: blur(28rpx);
  backdrop-filter: blur(28rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 20rpx 60rpx rgba(120, 130, 220, 0.25);
}

.panel-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2b3a67;
}

.panel-sub {
  margin-top: 6rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: rgba(43, 58, 103, 0.6);
}

/* 输入框：半透明白底与毛玻璃融合 */
.input-item {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-top: 14rpx;
  padding: 0 28rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 46rpx;
}

.input-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #2b3345;
}

.input-placeholder {
  color: rgba(90, 100, 130, 0.55);
  font-size: 30rpx;
}

.forgot-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.forgot-link {
  font-size: 24rpx;
  color: rgba(43, 58, 103, 0.55);
}

/* 登录按钮：蓝粉渐变，与标题字、卡片同色系，贴合整体页面 */
.login-btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 46rpx;
  background: linear-gradient(90deg, #7db4ff 0%, #a9a9ff 48%, #ffaad4 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  box-shadow: 0 12rpx 28rpx rgba(150, 140, 255, 0.45);
}

.login-btn::after {
  border: none;
}

.register-row {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 18rpx;
}

.register-text {
  font-size: 24rpx;
  color: rgba(43, 58, 103, 0.55);
}

.register-link {
  font-size: 24rpx;
  color: #4a7dff;
  margin-left: 8rpx;
  font-weight: 600;
}

/* 其他登录方式：卡片显现后错峰淡入 */
.panel-extra {
  margin-top: 18rpx;
  opacity: 0;
  transform: translateY(30rpx);
  transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

.panel-wrap.in .panel-extra {
  opacity: 1;
  transform: none;
  transition-delay: 0.35s;
}

.divider {
  display: flex;
  align-items: center;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: rgba(43, 58, 103, 0.12);
}

.divider-text {
  margin: 0 24rpx;
  font-size: 22rpx;
  color: rgba(43, 58, 103, 0.5);
}

.other-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 18rpx;
}

.other-icon {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(43, 162, 69, 0.35);
}

.other-icon.wechat {
  background: #2ba245;
}

.other-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.other-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(43, 58, 103, 0.6);
}

/* 协议 */
.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 14rpx;
}

.agreement-text {
  font-size: 20rpx;
  color: rgba(43, 58, 103, 0.45);
}

.agreement-link {
  font-size: 20rpx;
  color: #4a7dff;
}

/* ========== 忘记密码弹层：与卡片同款毛玻璃 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(40, 45, 70, 0.35);
}

.forgot-card {
  width: 600rpx;
  padding: 40rpx 40rpx 32rpx;
  border-radius: 40rpx;
  background: linear-gradient(155deg,
    rgba(125, 186, 255, 0.72) 0%,
    rgba(196, 200, 255, 0.66) 45%,
    rgba(255, 168, 214, 0.72) 100%);
  -webkit-backdrop-filter: blur(28rpx);
  backdrop-filter: blur(28rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 20rpx 60rpx rgba(120, 130, 220, 0.35);
  animation: modal-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes modal-pop {
  from { transform: scale(0.86); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.forgot-actions {
  display: flex;
  margin-top: 24rpx;
}

.forgot-cancel {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  margin-right: 20rpx;
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  color: #2b3a67;
  font-size: 30rpx;
}

.forgot-cancel::after {
  border: none;
}

.forgot-confirm {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: linear-gradient(90deg, #7db4ff 0%, #a9a9ff 48%, #ffaad4 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(150, 140, 255, 0.45);
}

.forgot-confirm::after {
  border: none;
}
